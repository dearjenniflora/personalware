        (function() {
            'use strict';

            // DOM refs
            const pages = document.querySelectorAll('.page');
            const navLinks = document.querySelectorAll('.header-nav a');
            const menuToggle = document.getElementById('menuToggle');
            const mainNav = document.getElementById('mainNav');

            // Helper: show page
            function showPage(pageId) {
                // Hide all pages
                pages.forEach(p => p.classList.remove('active'));

                // Show target
                const target = document.getElementById('page-' + pageId);
                if (target) target.classList.add('active');

                // Update nav active state
                navLinks.forEach(link => {
                    link.classList.toggle('active', link.dataset.page === pageId);
                });

                // Close mobile nav
                mainNav.classList.remove('open');
                menuToggle.classList.remove('open');
                menuToggle.setAttribute('aria-expanded', 'false');

                // Scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Nav click handler
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.dataset.page;
                    if (page) showPage(page);
                    // Update URL hash without scroll
                    history.pushState(null, '', '#' + page);
                });
            });

            // Also handle any internal links with data-page attribute (choice cards etc.)
            document.querySelectorAll('[data-page]').forEach(el => {
                // skip nav links already handled
                if (el.closest('.header-nav')) return;
                el.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.dataset.page;
                    if (page) showPage(page);
                    history.pushState(null, '', '#' + page);
                });
            });

            // Mobile menu toggle
            menuToggle.addEventListener('click', function() {
                const isOpen = mainNav.classList.toggle('open');
                this.classList.toggle('open');
                this.setAttribute('aria-expanded', isOpen);
            });

            // Close menu on link click (mobile)
            mainNav.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    mainNav.classList.remove('open');
                    menuToggle.classList.remove('open');
                    menuToggle.setAttribute('aria-expanded', 'false');
                });
            });

            // Handle hash on load
            function handleHash() {
                const hash = window.location.hash.replace('#', '');
                if (hash && ['home', 'personalware', 'about'].includes(hash)) {
                    showPage(hash);
                } else {
                    // default to home
                    showPage('home');
                }
            }

            // Handle back/forward
            window.addEventListener('popstate', function() {
                const hash = window.location.hash.replace('#', '');
                if (hash && ['home', 'personalware', 'about'].includes(hash)) {
                    showPage(hash);
                } else {
                    showPage('home');
                }
            });

            // Init
            handleHash();

            // CTA "Build yours" links that point to #global-cta should scroll smoothly
            document.querySelectorAll('a[href="#global-cta"]').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.getElementById('global-cta');
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Also handle any other anchor links that might be present
            document.querySelectorAll('a[href^="#"]').forEach(link => {
                const href = link.getAttribute('href');
                if (href === '#') return;
                const targetId = href.replace('#', '');
                if (targetId && targetId !== 'global-cta' && !['home', 'personalware', 'about'].includes(
                    targetId)) {
                    // Only handle internal page anchors if they exist
                    const targetEl = document.getElementById(targetId);
                    if (targetEl) {
                        link.addEventListener('click', function(e) {
                            e.preventDefault();
                            targetEl.scrollIntoView({ behavior: 'smooth' });
                        });
                    }
                }
            });

        })();
    </script>

</body>
</html>
