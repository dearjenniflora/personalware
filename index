<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PERSONALWARE · by Jennifer Flora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <style>
        /* ============================================================
                   RESET & BASE
                   ============================================================ */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --ivory: #f6f1eb;
            --near-black: #1e2b1f;
            --sage: #8a9b7a;
            --sage-light: #d6dfce;
            --sage-pale: #eef3e9;
            --border: #e0d9d0;
            --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
            --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            --transition: 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background: var(--ivory);
            color: var(--near-black);
            font-family: var(--sans);
            font-size: 16px;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            color: var(--near-black);
            text-decoration: none;
            transition: color var(--transition);
        }

        a:hover {
            color: var(--sage);
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 32px;
        }

        @media (max-width: 640px) {
            .container {
                padding: 0 20px;
            }
        }

        /* ============================================================
                   GLOBAL HEADER
                   ============================================================ */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(246, 241, 235, 0.88);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border-bottom: 1px solid var(--border);
            padding: 16px 0;
            transition: background var(--transition);
        }

        .site-header .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .header-brand {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-family: var(--serif);
            font-size: 1.1rem;
            letter-spacing: -0.01em;
        }

        .header-brand .brand-name {
            font-weight: 600;
            color: var(--near-black);
        }

        .header-brand .brand-by {
            font-weight: 400;
            font-size: 0.75rem;
            color: var(--sage);
            letter-spacing: 0.02em;
            font-family: var(--sans);
            text-transform: lowercase;
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 0.85rem;
            font-weight: 450;
            letter-spacing: 0.01em;
        }

        .header-nav a {
            position: relative;
            padding: 4px 0;
            color: var(--near-black);
            transition: color var(--transition);
        }

        .header-nav a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 1.5px;
            background: var(--sage);
            transition: width var(--transition);
        }

        .header-nav a:hover::after,
        .header-nav a.active::after {
            width: 100%;
        }

        .header-nav a.active {
            color: var(--near-black);
            font-weight: 500;
        }

        .header-nav a:not(.active) {
            color: rgba(30, 43, 31, 0.6);
        }

        .header-nav a:not(.active):hover {
            color: var(--near-black);
        }

        /* Mobile menu toggle */
        .menu-toggle {
            display: none;
            flex-direction: column;
            gap: 4px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
        }

        .menu-toggle span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--near-black);
            transition: var(--transition);
            border-radius: 2px;
        }

        .menu-toggle.open span:nth-child(1) {
            transform: translateY(6px) rotate(45deg);
        }
        .menu-toggle.open span:nth-child(2) {
            opacity: 0;
        }
        .menu-toggle.open span:nth-child(3) {
            transform: translateY(-6px) rotate(-45deg);
        }

        @media (max-width: 720px) {
            .menu-toggle {
                display: flex;
            }

            .header-nav {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
                padding: 20px 32px 28px;
                background: rgba(246, 241, 235, 0.98);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                border-bottom: 1px solid var(--border);
                opacity: 0;
                pointer-events: none;
                transform: translateY(-8px);
                transition: var(--transition);
            }

            .header-nav.open {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
            }

            .header-nav a {
                font-size: 1rem;
                padding: 6px 0;
            }
        }

        /* ============================================================
                   PAGE CONTAINER
                   ============================================================ */
        .page-container {
            flex: 1;
            padding-top: 8px;
        }

        .page {
            display: none;
            animation: fadePage 0.4s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fadePage {
            0% {
                opacity: 0;
                transform: translateY(12px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============================================================
                   GLOBAL CTA FOOTER
                   ============================================================ */
        .global-cta {
            margin-top: 80px;
            padding: 72px 0 56px;
            border-top: 1px solid var(--border);
            background: var(--ivory);
        }

        .global-cta .cta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
        }

        .global-cta .cta-left {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .global-cta .cta-left .cta-label {
            font-family: var(--sans);
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .global-cta .cta-left h3 {
            font-family: var(--serif);
            font-size: 2rem;
            font-weight: 600;
            line-height: 1.2;
            color: var(--near-black);
        }

        .global-cta .cta-left .cta-sub {
            font-size: 1rem;
            color: rgba(30, 43, 31, 0.7);
            max-width: 380px;
            margin-top: 4px;
        }

        .global-cta .cta-left .cta-sub em {
            font-style: italic;
            font-family: var(--serif);
            color: var(--near-black);
        }

        .global-cta .cta-right {
            display: flex;
            flex-direction: column;
            gap: 24px;
            justify-content: center;
        }

        .global-cta .cta-option {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 20px;
            border: 1px solid var(--border);
            border-radius: 4px;
            transition: var(--transition);
            background: rgba(255, 255, 255, 0.3);
        }

        .global-cta .cta-option:hover {
            border-color: var(--sage);
            background: rgba(138, 155, 122, 0.06);
        }

        .global-cta .cta-option .option-icon {
            font-size: 1.4rem;
            opacity: 0.6;
            flex-shrink: 0;
        }

        .global-cta .cta-option .option-content {
            flex: 1;
        }

        .global-cta .cta-option .option-content .option-title {
            font-weight: 550;
            font-size: 1rem;
            color: var(--near-black);
        }

        .global-cta .cta-option .option-content .option-desc {
            font-size: 0.85rem;
            color: rgba(30, 43, 31, 0.6);
            margin-top: 2px;
        }

        .global-cta .cta-option .option-arrow {
            font-size: 1.2rem;
            color: var(--sage);
            transition: transform var(--transition);
        }

        .global-cta .cta-option:hover .option-arrow {
            transform: translateX(4px);
        }

        .global-cta .cta-qr-hint {
            display: flex;
            gap: 24px;
            margin-top: 8px;
            font-size: 0.8rem;
            color: rgba(30, 43, 31, 0.5);
            flex-wrap: wrap;
        }

        .global-cta .cta-qr-hint .qr-placeholder {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 4px 12px 4px 8px;
            border: 1px dashed var(--border);
            border-radius: 4px;
            font-size: 0.7rem;
            color: var(--sage);
        }

        .global-cta .cta-qr-hint .qr-placeholder span {
            font-size: 1.2rem;
        }

        @media (max-width: 720px) {
            .global-cta .cta-grid {
                grid-template-columns: 1fr;
                gap: 32px;
            }

            .global-cta .cta-left h3 {
                font-size: 1.6rem;
            }

            .global-cta .cta-left .cta-sub {
                max-width: 100%;
            }

            .global-cta .cta-option {
                padding: 14px 16px;
            }

            .global-cta .cta-qr-hint {
                flex-direction: column;
                gap: 10px;
            }
        }

        /* ============================================================
                   HOMEPAGE
                   ============================================================ */
        /* Hero */
        .home-hero {
            padding: 48px 0 40px;
            position: relative;
        }

        .home-hero .hero-content {
            display: flex;
            flex-direction: column;
            gap: 12px;
            position: relative;
        }

        .home-hero .hero-flora-mark {
            position: absolute;
            right: 0;
            top: -20px;
            width: 140px;
            height: 140px;
            opacity: 0.10;
            pointer-events: none;
        }

        .home-hero .hero-flora-mark svg {
            width: 100%;
            height: 100%;
        }

        .home-hero .hero-badge {
            font-family: var(--sans);
            font-size: 0.7rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .home-hero h1 {
            font-family: var(--serif);
            font-size: clamp(3.2rem, 12vw, 6.5rem);
            font-weight: 700;
            line-height: 1.02;
            letter-spacing: -0.02em;
            color: var(--near-black);
        }

        .home-hero .hero-byline {
            font-family: var(--serif);
            font-size: clamp(1rem, 2vw, 1.3rem);
            font-style: italic;
            color: var(--sage);
            margin-top: -4px;
        }

        .home-hero .hero-tagline {
            font-family: var(--serif);
            font-size: clamp(1.6rem, 4vw, 2.8rem);
            font-weight: 400;
            line-height: 1.2;
            color: var(--near-black);
            margin-top: 8px;
        }

        .home-hero .hero-sub {
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(30, 43, 31, 0.4);
            margin-top: 4px;
            font-weight: 450;
        }

        .home-hero .hero-text-block {
            margin-top: 32px;
            max-width: 540px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .home-hero .hero-text-block .hero-main-text {
            font-size: 1.15rem;
            line-height: 1.7;
            color: var(--near-black);
            font-weight: 400;
        }

        .home-hero .hero-text-block .hero-main-text strong {
            font-weight: 500;
            color: var(--near-black);
        }

        .home-hero .hero-text-block .hero-chinese {
            font-size: 0.95rem;
            color: rgba(30, 43, 31, 0.55);
            font-weight: 400;
            border-left: 2px solid var(--sage-light);
            padding-left: 16px;
        }

        .home-hero .hero-made {
            margin-top: 12px;
            font-family: var(--serif);
            font-size: 1.2rem;
            font-style: italic;
            color: var(--sage);
        }

        .home-hero .hero-ctas {
            display: flex;
            flex-wrap: wrap;
            gap: 20px 32px;
            margin-top: 28px;
        }

        .home-hero .hero-ctas .cta-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
            font-weight: 480;
            color: var(--near-black);
            border-bottom: 1.5px solid var(--sage-light);
            padding-bottom: 4px;
            transition: var(--transition);
        }

        .home-hero .hero-ctas .cta-link:hover {
            border-color: var(--sage);
            color: var(--near-black);
        }

        .home-hero .hero-ctas .cta-link .arrow {
            font-size: 1.1rem;
            transition: transform var(--transition);
        }

        .home-hero .hero-ctas .cta-link:hover .arrow {
            transform: translateX(4px);
        }

        @media (max-width: 640px) {
            .home-hero {
                padding: 24px 0 20px;
            }

            .home-hero .hero-flora-mark {
                width: 80px;
                height: 80px;
                top: 0;
            }

            .home-hero .hero-text-block {
                max-width: 100%;
            }

            .home-hero .hero-ctas {
                flex-direction: column;
                gap: 14px;
            }
        }

        /* Homepage理念区 */
        .home-philosophy {
            padding: 60px 0 32px;
            border-top: 1px solid var(--border);
        }

        .home-philosophy .philosophy-question {
            font-family: var(--serif);
            font-size: clamp(1.4rem, 3vw, 2.2rem);
            font-weight: 400;
            line-height: 1.4;
            max-width: 640px;
            color: var(--near-black);
        }

        .home-philosophy .philosophy-examples {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px 40px;
            margin-top: 32px;
            max-width: 700px;
        }

        .home-philosophy .philosophy-examples li {
            list-style: none;
            font-size: 0.95rem;
            color: rgba(30, 43, 31, 0.7);
            padding: 6px 0 6px 20px;
            border-left: 2px solid var(--sage-light);
            line-height: 1.5;
        }

        .home-philosophy .philosophy-closing {
            margin-top: 36px;
            font-family: var(--serif);
            font-size: 1.2rem;
            font-style: italic;
            color: var(--near-black);
            max-width: 480px;
            line-height: 1.5;
        }

        .home-philosophy .philosophy-closing span {
            display: block;
            margin-top: 6px;
            font-style: normal;
            font-family: var(--sans);
            font-size: 0.9rem;
            color: rgba(30, 43, 31, 0.5);
        }

        @media (max-width: 600px) {
            .home-philosophy .philosophy-examples {
                grid-template-columns: 1fr;
                gap: 8px;
            }
        }

        /* Homepage导航选择 */
        .home-choice {
            padding: 48px 0 8px;
            border-top: 1px solid var(--border);
        }

        .home-choice .choice-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            max-width: 700px;
        }

        .home-choice .choice-card {
            padding: 24px 28px 28px;
            border: 1px solid var(--border);
            border-radius: 4px;
            transition: var(--transition);
            background: rgba(255, 255, 255, 0.2);
        }

        .home-choice .choice-card:hover {
            border-color: var(--sage);
            background: rgba(138, 155, 122, 0.04);
            transform: translateY(-2px);
        }

        .home-choice .choice-card .choice-label {
            font-size: 0.65rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .home-choice .choice-card h4 {
            font-family: var(--serif);
            font-size: 1.4rem;
            font-weight: 600;
            margin: 8px 0 4px;
            color: var(--near-black);
        }

        .home-choice .choice-card p {
            font-size: 0.9rem;
            color: rgba(30, 43, 31, 0.6);
            line-height: 1.5;
        }

        .home-choice .choice-card .choice-arrow {
            display: inline-block;
            margin-top: 12px;
            font-size: 0.95rem;
            color: var(--sage);
            font-weight: 450;
            transition: var(--transition);
        }

        .home-choice .choice-card:hover .choice-arrow {
            transform: translateX(4px);
        }

        @media (max-width: 600px) {
            .home-choice .choice-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .home-choice .choice-card {
                padding: 20px;
            }
        }

        /* ============================================================
                   PERSONALWARE PAGE
                   ============================================================ */
        .pw-opening {
            padding: 32px 0 40px;
        }

        .pw-opening .pw-label {
            font-family: var(--sans);
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .pw-opening h2 {
            font-family: var(--serif);
            font-size: clamp(2.2rem, 5vw, 3.8rem);
            font-weight: 600;
            line-height: 1.1;
            margin-top: 6px;
            color: var(--near-black);
        }

        .pw-opening .pw-sub {
            font-size: 1.05rem;
            color: rgba(30, 43, 31, 0.6);
            max-width: 480px;
            margin-top: 8px;
            font-weight: 400;
        }

        /* Case Studies */
        .pw-cases {
            padding: 16px 0 8px;
        }

        .case-item {
            padding: 48px 0 48px;
            border-top: 1px solid var(--border);
        }

        .case-item:first-of-type {
            border-top: none;
        }

        .case-item .case-meta {
            display: flex;
            align-items: baseline;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }

        .case-item .case-meta .case-seed {
            font-family: var(--sans);
            font-size: 0.7rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .case-item .case-meta .case-tags {
            font-size: 0.75rem;
            color: rgba(30, 43, 31, 0.35);
            font-weight: 400;
        }

        .case-item .case-title {
            font-family: var(--serif);
            font-size: clamp(1.6rem, 3.5vw, 2.8rem);
            font-weight: 600;
            line-height: 1.15;
            color: var(--near-black);
        }

        .case-item .case-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 40px 56px;
            margin-top: 20px;
        }

        .case-item .case-details {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .case-item .case-details .detail-block {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .case-item .case-details .detail-block .detail-label {
            font-size: 0.65rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--sage);
            font-weight: 500;
        }

        .case-item .case-details .detail-block .detail-value {
            font-size: 1rem;
            color: var(--near-black);
            line-height: 1.5;
        }

        .case-item .case-details .detail-block .detail-value .highlight {
            background: var(--sage-pale);
            padding: 0 6px;
            border-radius: 2px;
        }

        .case-item .case-visual {
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 24px 20px 20px;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            transition: var(--transition);
        }

        .case-item .case-visual:hover {
            border-color: var(--sage-light);
        }

        .case-item .case-visual .visual-placeholder {
            font-size: 0.85rem;
            color: rgba(30, 43, 31, 0.3);
            font-weight: 400;
        }

        .case-item .case-visual .visual-placeholder strong {
            color: var(--sage);
            font-weight: 500;
        }

        .case-item .case-visual .visual-icon {
            font-size: 2.6rem;
            margin-bottom: 8px;
            opacity: 0.5;
        }

        .case-item .case-annotation {
            font-size: 0.75rem;
            color: rgba(30, 43, 31, 0.35);
            margin-top: 12px;
            grid-column: 1 / -1;
            text-align: right;
            border-top: 1px solid var(--border);
            padding-top: 12px;
        }

        @media (max-width: 720px) {
            .case-item .case-grid {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .case-item {
                padding: 32px 0;
            }

            .case-item .case-visual {
                min-height: 140px;
                padding: 20px 16px;
            }
        }

        /* Mid-page CTA in Personalware */
        .pw-mid-cta {
            padding: 40px 0 24px;
            border-top: 1px solid var(--border);
            margin-top: 16px;
        }

        .pw-mid-cta .mid-cta-content {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 12px 20px;
        }

        .pw-mid-cta .mid-cta-content p {
            font-family: var(--serif);
            font-size: 1.3rem;
            font-style: italic;
            color: var(--near-black);
        }

        .pw-mid-cta .mid-cta-content a {
            font-size: 1rem;
            font-weight: 480;
            color: var(--sage);
            border-bottom: 1.5px solid var(--sage-light);
            padding-bottom: 3px;
            transition: var(--transition);
        }

        .pw-mid-cta .mid-cta-content a:hover {
            border-color: var(--sage);
            color: var(--near-black);
        }

        /* ============================================================
                   ABOUT PAGE
                   ============================================================ */
        .about-opening {
            padding: 32px 0 40px;
        }

        .about-opening .about-label {
            font-family: var(--sans);
            font-size: 0.7rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--sage);
